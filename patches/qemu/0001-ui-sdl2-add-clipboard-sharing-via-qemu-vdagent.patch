@@ -0,0 +1,127 @@
+/*
+ * SDL UI -- clipboard support
+ *
+ * Bridges the SDL2 display's host clipboard with the qemu internal
+ * clipboard manager (ui/clipboard.c), the same way ui/gtk-clipboard.c
+ * does for the GTK UI. This lets a chardev peer such as qemu-vdagent
+ * exchange clipboard text with a guest over virtio-serial while
+ * running -display sdl.
+ *
+ * SDL's clipboard API has no delayed-render / lazy provider mechanism
+ * like X11/GTK does, so the guest -> host direction pulls the data
+ * eagerly as soon as the guest grabs the qemu clipboard, instead of
+ * waiting for a host-side paste. The host -> guest direction stays
+ * lazy: the local clipboard text is only read when the guest actually
+ * requests it.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, see <http://www.gnu.org/licenses/>.
+ */
+
+#include "qemu/osdep.h"
+#include "ui/sdl2.h"
+
+static QemuClipboardPeer sdl2_cbpeer;
+static char *sdl2_synced_text;
+
+static void sdl2_clipboard_remember(const char *text)
+{
+    g_free(sdl2_synced_text);
+    sdl2_synced_text = g_strdup(text);
+}
+
+static void sdl2_clipboard_request(QemuClipboardInfo *info,
+                                    QemuClipboardType type)
+{
+    char *text;
+
+    if (type != QEMU_CLIPBOARD_TYPE_TEXT) {
+        return;
+    }
+
+    text = SDL_GetClipboardText();
+    if (text && text[0]) {
+        qemu_clipboard_set_data(&sdl2_cbpeer, info, type,
+                                strlen(text), text, true);
+    }
+    SDL_free(text);
+}
+
+static void sdl2_clipboard_notify(Notifier *notifier, void *data)
+{
+    QemuClipboardNotify *notify = data;
+    QemuClipboardInfo *info;
+
+    if (notify->type != QEMU_CLIPBOARD_UPDATE_INFO) {
+        return;
+    }
+
+    info = notify->info;
+    if (info->owner == &sdl2_cbpeer ||
+        info->selection != QEMU_CLIPBOARD_SELECTION_CLIPBOARD) {
+        return;
+    }
+    if (!info->types[QEMU_CLIPBOARD_TYPE_TEXT].available) {
+        return;
+    }
+
+    if (info->types[QEMU_CLIPBOARD_TYPE_TEXT].data) {
+        /* data arrived in response to our own request below */
+        sdl2_clipboard_remember(info->types[QEMU_CLIPBOARD_TYPE_TEXT].data);
+        SDL_SetClipboardText(info->types[QEMU_CLIPBOARD_TYPE_TEXT].data);
+        return;
+    }
+
+    /* a new peer just grabbed the clipboard, pull the actual text now */
+    qemu_clipboard_request(info, QEMU_CLIPBOARD_TYPE_TEXT);
+}
+
+void sdl2_clipboard_update(void)
+{
+    QemuClipboardInfo *info;
+    char *text;
+
+    if (qemu_clipboard_peer_owns(&sdl2_cbpeer,
+                                 QEMU_CLIPBOARD_SELECTION_CLIPBOARD)) {
+        return;
+    }
+    if (!SDL_HasClipboardText()) {
+        return;
+    }
+
+    text = SDL_GetClipboardText();
+    if (!text || !text[0]) {
+        SDL_free(text);
+        return;
+    }
+    if (sdl2_synced_text && strcmp(text, sdl2_synced_text) == 0) {
+        SDL_free(text);
+        return;
+    }
+
+    info = qemu_clipboard_info_new(&sdl2_cbpeer,
+                                   QEMU_CLIPBOARD_SELECTION_CLIPBOARD);
+    info->types[QEMU_CLIPBOARD_TYPE_TEXT].available = true;
+    qemu_clipboard_update(info);
+    qemu_clipboard_info_unref(info);
+
+    SDL_free(text);
+}
+
+void sdl2_clipboard_init(void)
+{
+    sdl2_cbpeer.name = "sdl";
+    sdl2_cbpeer.notifier.notify = sdl2_clipboard_notify;
+    sdl2_cbpeer.request = sdl2_clipboard_request;
+    qemu_clipboard_peer_register(&sdl2_cbpeer);
+}
